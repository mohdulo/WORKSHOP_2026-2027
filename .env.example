# PaySim — variables optionnelles pour `docker compose up` (copier ce fichier en .env, jamais commité).
# Sans .env, le conteneur démarre avec les clés de TEST publiques du dépôt (voir README) : OK pour une démo, jamais au-delà.

# Port exposé sur la machine hôte (le conteneur écoute toujours sur 4000).
PAYSIM_PORT=4000

# Clés API (format imposé : sk_test_ / pk_test_ suivi d'au moins 16 caractères alphanumériques).
#SECRET_KEY=sk_test_
#PUBLISHABLE_KEY=pk_test_

# Clé AES-256 du coffre-fort carte : 64 caractères hexadécimaux, à générer avec `openssl rand -hex 32`.
#VAULT_KEY=
# Clé HMAC des empreintes de carte (16 caractères minimum).
#FINGERPRINT_KEY=

# Mode production : exige une VAULT_KEY personnalisée, désactive l'horloge de test et active
# `upgrade-insecure-requests` (le site doit alors être servi en HTTPS, ex. derrière un reverse proxy TLS).
#NODE_ENV=production

# Niveau de log : fatal, error, warn, info, debug, trace.
#LOG_LEVEL=info
